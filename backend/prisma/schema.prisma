generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id        String    @id @default(uuid())
  slug      String    @unique @db.VarChar(64)
  name      String
  status    String    @default("active")
  planCode  String?   @map("plan_code")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  users         User[]
  sessions      AuthSession[]
  companies     Company[]
  factories     Factory[]
  roles         Role[]
  userRoles     UserRole[]
  userScopes    UserScope[]
  tenantModules TenantModule[]
  customFields  CustomFieldDefinition[]
  warehouses       Warehouse[]
  uoms             UnitOfMeasure[]
  items            Item[]
  lots             Lot[]
  stockBalances    StockBalance[]
  stockLedgers     StockLedgerEntry[]
  stockTransfers   StockTransfer[]
  stockAdjustments StockAdjustment[]

  @@map("tenant")
}

model User {
  id               String    @id @default(uuid())
  tenantId         String?   @map("tenant_id")
  email            String
  name             String
  passwordHash     String?   @map("password_hash")
  status           String    @default("active")
  isPlatformAdmin  Boolean   @default(false) @map("is_platform_admin")
  inviteTokenHash  String?   @unique @map("invite_token_hash")
  inviteExpiresAt  DateTime? @map("invite_expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deactivatedAt    DateTime? @map("deactivated_at")

  tenant     Tenant?       @relation(fields: [tenantId], references: [id])
  sessions   AuthSession[]
  userRoles  UserRole[]
  userScopes UserScope[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@map("user_account")
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  tenantId         String?   @map("tenant_id")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  clientSignature  String?   @map("client_signature")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([userId])
  @@map("auth_session")
}

model Company {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  name        String
  code        String    @db.VarChar(64)
  taxId       String?   @map("tax_id")
  currency    String    @default("USD") @db.Char(3)
  addressJson Json?     @map("address_json")
  status      String    @default("active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  factories Factory[]
  warehouses Warehouse[]
  items     Item[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("company")
}

model Factory {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  companyId   String    @map("company_id")
  name        String
  code        String    @db.VarChar(64)
  timezone    String    @default("UTC")
  addressJson Json?     @map("address_json")
  status      String    @default("active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  company    Company     @relation(fields: [companyId], references: [id])
  warehouses Warehouse[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@map("factory")
}

/// Platform permission catalog (Document 02 §21.1)
model PermissionCatalog {
  id          String @id @default(uuid())
  code        String @unique
  moduleCode  String @map("module_code")
  description String?

  rolePermissions RolePermission[]

  @@map("permission_catalog")
}

/// Tenant-scoped role (Document 02 §21.2)
model Role {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  code        String    @db.VarChar(64)
  name        String
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("role")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role               @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission PermissionCatalog  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model UserRole {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([tenantId, userId])
  @@map("user_role")
}

/// Factory (or later warehouse) scope limits (Document 02 §21.5)
model UserScope {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  scopeType String   @map("scope_type") // factory | warehouse | company
  scopeId   String   @map("scope_id")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scopeType, scopeId])
  @@index([tenantId, userId])
  @@map("user_scope")
}

/// Global system module catalog (Document 02 §22)
model ModuleCatalog {
  id             String   @id @default(uuid())
  code           String   @unique @db.VarChar(64)
  name           String
  description    String?
  category       String   @default("core") @db.VarChar(64)
  isCore         Boolean  @default(false) @map("is_core")
  defaultEnabled Boolean  @default(true) @map("default_enabled")
  createdAt      DateTime @default(now()) @map("created_at")

  tenantModules TenantModule[]

  @@map("module_catalog")
}

/// Tenant-scoped module activation & config (Document 02 §22, §31)
model TenantModule {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  moduleCode  String   @map("module_code") @db.VarChar(64)
  enabled     Boolean  @default(true)
  configJson  Json?    @map("config_json")
  enabledAt   DateTime @default(now()) @map("enabled_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  module ModuleCatalog @relation(fields: [moduleCode], references: [code])

  @@unique([tenantId, moduleCode])
  @@index([tenantId])
  @@map("tenant_module")
}

/// Tenant-scoped custom metadata field definitions (ADR-0011, Document 02 §31)
model CustomFieldDefinition {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  entityType  String    @map("entity_type") @db.VarChar(64) // e.g. factory, item, work_order
  fieldKey    String    @map("field_key") @db.VarChar(64)
  label       String
  dataType    String    @default("string") @map("data_type") @db.VarChar(32) // string, number, boolean, select, date
  isRequired  Boolean   @default(false) @map("is_required")
  optionsJson Json?     @map("options_json")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, entityType, fieldKey])
  @@index([tenantId, entityType])
  @@map("custom_field_definition")
}

// -----------------------------------------------------------------------------
// Section 7 — Inventory Core Models
// -----------------------------------------------------------------------------

/// Warehouse storage location (Document 02 §23)
model Warehouse {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  companyId   String    @map("company_id")
  factoryId   String?   @map("factory_id")
  code        String    @db.VarChar(64)
  name        String
  type        String    @default("RM") @db.VarChar(32) // RM, WIP, FG, SPARE, SCRAP
  status      String    @default("active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  company       Company            @relation(fields: [companyId], references: [id])
  factory       Factory?           @relation(fields: [factoryId], references: [id])
  stockBalances StockBalance[]
  stockLedgers  StockLedgerEntry[]

  fromTransfers StockTransfer[] @relation("FromWarehouse")
  toTransfers   StockTransfer[] @relation("ToWarehouse")
  adjustments   StockAdjustment[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@map("warehouse")
}

/// Unit of Measure catalog (Document 02 §23.1)
model UnitOfMeasure {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  code      String    @db.VarChar(32)
  name      String
  symbol    String?   @db.VarChar(16)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  items         Item[]
  stockLedgers  StockLedgerEntry[]
  transferLines StockTransferLine[]
  adjLines      StockAdjustmentLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("uom")
}

/// Item Master Catalog (Document 02 §23.2)
model Item {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  companyId       String?   @map("company_id")
  code            String    @db.VarChar(64)
  name            String
  itemType        String    @default("RM") @map("item_type") @db.VarChar(32) // RM, WIP, FG, SPARE, CONSUMABLE
  uomId           String    @map("uom_id")
  trackingType    String    @default("none") @map("tracking_type") @db.VarChar(32) // none, lot, serial
  valuationMethod String    @default("average") @map("valuation_method") @db.VarChar(32) // standard, average, fifo
  status          String    @default("active")
  attrsJson       Json?     @map("attrs_json")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  company  Company?       @relation(fields: [companyId], references: [id])
  uom      UnitOfMeasure  @relation(fields: [uomId], references: [id])

  lots          Lot[]
  stockBalances StockBalance[]
  stockLedgers  StockLedgerEntry[]
  transferLines StockTransferLine[]
  adjLines      StockAdjustmentLine[]

  @@unique([tenantId, code])
  @@index([tenantId, itemType, status])
  @@map("item")
}

/// Lot / Batch Tracking (Document 02 §23.4)
model Lot {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  itemId           String    @map("item_id")
  lotCode          String    @map("lot_code") @db.VarChar(64)
  manufacturedDate DateTime? @map("manufactured_date")
  expiryDate       DateTime? @map("expiry_date")
  attrsJson        Json?     @map("attrs_json")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  item   Item   @relation(fields: [itemId], references: [id])

  stockBalances StockBalance[]
  stockLedgers  StockLedgerEntry[]

  @@unique([tenantId, itemId, lotCode])
  @@index([tenantId, itemId])
  @@map("lot")
}

/// Materialized Stock Balance (Document 02 §23.3)
model StockBalance {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  warehouseId String   @map("warehouse_id")
  itemId      String   @map("item_id")
  lotId       String?  @map("lot_id")
  qtyOnHand   Float    @default(0) @map("qty_on_hand")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  item      Item      @relation(fields: [itemId], references: [id])
  lot       Lot?      @relation(fields: [lotId], references: [id])

  @@unique([warehouseId, itemId])
  @@index([tenantId, warehouseId])
  @@map("stock_balance")
}

/// Append-Only Stock Ledger Entry (Document 02 §23.5)
model StockLedgerEntry {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  companyId    String   @map("company_id")
  factoryId    String?  @map("factory_id")
  warehouseId  String   @map("warehouse_id")
  itemId       String   @map("item_id")
  lotId        String?  @map("lot_id")
  qtyIn        Float    @default(0) @map("qty_in")
  qtyOut       Float    @default(0) @map("qty_out")
  uomId        String   @map("uom_id")
  unitCost     Float?   @map("unit_cost")
  movementType String   @map("movement_type") @db.VarChar(32) // GRN, ISSUE, OUTPUT, TRANSFER_IN, TRANSFER_OUT, ADJUST
  refDocType   String?  @map("ref_doc_type") @db.VarChar(32)
  refDocId     String?  @map("ref_doc_id")
  refLineId    String?  @map("ref_line_id")
  occurredAt   DateTime @default(now()) @map("occurred_at")
  createdAt    DateTime @default(now()) @map("created_at")
  createdBy    String?  @map("created_by")

  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  warehouse Warehouse     @relation(fields: [warehouseId], references: [id])
  item      Item          @relation(fields: [itemId], references: [id])
  lot       Lot?          @relation(fields: [lotId], references: [id])
  uom       UnitOfMeasure @relation(fields: [uomId], references: [id])

  @@index([tenantId, warehouseId, itemId, createdAt])
  @@map("stock_ledger_entry")
}

/// Stock Transfer Header (Document 02 §23.6)
model StockTransfer {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  transferNumber  String    @map("transfer_number") @db.VarChar(64)
  fromWarehouseId String    @map("from_warehouse_id")
  toWarehouseId   String    @map("to_warehouse_id")
  status          String    @default("draft") @db.VarChar(32) // draft, posted, cancelled
  notes           String?
  postedAt        DateTime? @map("posted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  fromWarehouse Warehouse           @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse           @relation("ToWarehouse", fields: [toWarehouseId], references: [id])
  lines         StockTransferLine[]

  @@unique([tenantId, transferNumber])
  @@index([tenantId])
  @@map("stock_transfer")
}

/// Stock Transfer Line Items
model StockTransferLine {
  id         String @id @default(uuid())
  transferId String @map("transfer_id")
  itemId     String @map("item_id")
  uomId      String @map("uom_id")
  qty        Float

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item     Item          @relation(fields: [itemId], references: [id])
  uom      UnitOfMeasure @relation(fields: [uomId], references: [id])

  @@map("stock_transfer_line")
}

/// Stock Adjustment Header (Document 02 §23.7)
model StockAdjustment {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  adjustmentNumber String    @map("adjustment_number") @db.VarChar(64)
  warehouseId      String    @map("warehouse_id")
  reasonCode       String    @map("reason_code") @db.VarChar(64) // e.g. AUDIT_DISCREPANCY, DAMAGE, EXPIRATION
  status           String    @default("draft") @db.VarChar(32) // draft, posted
  notes            String?
  postedAt         DateTime? @map("posted_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant    Tenant                @relation(fields: [tenantId], references: [id])
  warehouse Warehouse             @relation(fields: [warehouseId], references: [id])
  lines     StockAdjustmentLine[]

  @@unique([tenantId, adjustmentNumber])
  @@index([tenantId])
  @@map("stock_adjustment")
}

/// Stock Adjustment Line Items
model StockAdjustmentLine {
  id           String @id @default(uuid())
  adjustmentId String @map("adjustment_id")
  itemId       String @map("item_id")
  uomId        String @map("uom_id")
  qty          Float  // positive = add stock, negative = remove stock

  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  item       Item            @relation(fields: [itemId], references: [id])
  uom        UnitOfMeasure   @relation(fields: [uomId], references: [id])

  @@map("stock_adjustment_line")
}


