generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id               String    @id @default(uuid())
  slug             String    @unique @db.VarChar(64)
  name             String
  status           String    @default("active")
  planCode         String?   @map("plan_code")
  allowedCidrsJson Json?     @map("allowed_cidrs_json")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  users         User[]
  sessions      AuthSession[]
  companies     Company[]
  factories     Factory[]
  roles         Role[]
  userRoles     UserRole[]
  userScopes    UserScope[]
  tenantModules TenantModule[]
  customFields  CustomFieldDefinition[]
  auditLogs     AuditLog[]
  warehouses       Warehouse[]
  uoms             UnitOfMeasure[]
  items            Item[]
  lots             Lot[]
  stockBalances    StockBalance[]
  stockLedgers     StockLedgerEntry[]
  stockTransfers   StockTransfer[]
  stockAdjustments StockAdjustment[]
  bomHeaders       BomHeader[]
  workOrders       WorkOrder[]
  energyLogs       EnergyLog[]
  parties          Party[]
  purchaseOrders   PurchaseOrder[]
  grns             Grn[]
  salesOrders      SalesOrder[]
  dispatches       Dispatch[]
  steelScrapReceipts SteelScrapReceipt[]
  steelHeatLogs    SteelHeatLog[]
  steelRollingLogs SteelRollingLog[]

  @@map("tenant")
}

model User {
  id               String    @id @default(uuid())
  tenantId         String?   @map("tenant_id")
  email            String
  name             String
  passwordHash     String?   @map("password_hash")
  status           String    @default("active")
  isPlatformAdmin  Boolean   @default(false) @map("is_platform_admin")
  twoFactorSecret  String?   @map("two_factor_secret")
  twoFactorEnabled Boolean   @default(false) @map("two_factor_enabled")
  inviteTokenHash  String?   @unique @map("invite_token_hash")
  inviteExpiresAt  DateTime? @map("invite_expires_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deactivatedAt    DateTime? @map("deactivated_at")

  tenant     Tenant?       @relation(fields: [tenantId], references: [id])
  sessions   AuthSession[]
  userRoles  UserRole[]
  userScopes UserScope[]
  auditLogs  AuditLog[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@map("user_account")
}

model AuthSession {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  tenantId         String?   @map("tenant_id")
  refreshTokenHash String    @unique @map("refresh_token_hash")
  clientSignature  String?   @map("client_signature")
  ipAddress        String?   @map("ip_address")
  userAgent        String?   @map("user_agent")
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  tenant Tenant? @relation(fields: [tenantId], references: [id])

  @@index([userId])
  @@map("auth_session")
}

model Company {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  name        String
  code        String    @db.VarChar(64)
  taxId       String?   @map("tax_id")
  currency    String    @default("USD") @db.Char(3)
  addressJson Json?     @map("address_json")
  status      String    @default("active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant    Tenant      @relation(fields: [tenantId], references: [id])
  factories Factory[]
  warehouses Warehouse[]
  items     Item[]
  parties   Party[]
  purchaseOrders PurchaseOrder[]
  grns      Grn[]
  salesOrders SalesOrder[]
  dispatches Dispatch[]
  steelScrapReceipts SteelScrapReceipt[]
  steelHeatLogs    SteelHeatLog[]
  steelRollingLogs SteelRollingLog[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("company")
}

model Factory {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  companyId   String    @map("company_id")
  name        String
  code        String    @db.VarChar(64)
  timezone    String    @default("UTC")
  addressJson Json?     @map("address_json")
  status      String    @default("active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  company    Company     @relation(fields: [companyId], references: [id])
  warehouses Warehouse[]
  steelHeatLogs SteelHeatLog[]
  steelRollingLogs SteelRollingLog[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@map("factory")
}

/// Platform permission catalog (Document 02 §21.1)
model PermissionCatalog {
  id          String @id @default(uuid())
  code        String @unique
  moduleCode  String @map("module_code")
  description String?

  rolePermissions RolePermission[]

  @@map("permission_catalog")
}

/// Tenant-scoped role (Document 02 §21.2)
model Role {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  code        String    @db.VarChar(64)
  name        String
  description String?
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  userRoles   UserRole[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("role")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role               @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission PermissionCatalog  @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permission")
}

model UserRole {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  roleId    String   @map("role_id")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([tenantId, userId])
  @@map("user_role")
}

/// Factory (or later warehouse) scope limits (Document 02 §21.5)
model UserScope {
  id        String   @id @default(uuid())
  tenantId  String   @map("tenant_id")
  userId    String   @map("user_id")
  scopeType String   @map("scope_type") // factory | warehouse | company
  scopeId   String   @map("scope_id")
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, scopeType, scopeId])
  @@index([tenantId, userId])
  @@map("user_scope")
}

/// Global system module catalog (Document 02 §22)
model ModuleCatalog {
  id             String   @id @default(uuid())
  code           String   @unique @db.VarChar(64)
  name           String
  description    String?
  category       String   @default("core") @db.VarChar(64)
  isCore         Boolean  @default(false) @map("is_core")
  defaultEnabled Boolean  @default(true) @map("default_enabled")
  createdAt      DateTime @default(now()) @map("created_at")

  tenantModules TenantModule[]

  @@map("module_catalog")
}

/// Tenant-scoped module activation & config (Document 02 §22, §31)
model TenantModule {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  moduleCode  String   @map("module_code") @db.VarChar(64)
  enabled     Boolean  @default(true)
  configJson  Json?    @map("config_json")
  enabledAt   DateTime @default(now()) @map("enabled_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant Tenant        @relation(fields: [tenantId], references: [id])
  module ModuleCatalog @relation(fields: [moduleCode], references: [code])

  @@unique([tenantId, moduleCode])
  @@index([tenantId])
  @@map("tenant_module")
}

/// Tenant-scoped custom metadata field definitions (ADR-0011, Document 02 §31)
model CustomFieldDefinition {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  entityType  String    @map("entity_type") @db.VarChar(64) // e.g. factory, item, work_order
  fieldKey    String    @map("field_key") @db.VarChar(64)
  label       String
  dataType    String    @default("string") @map("data_type") @db.VarChar(32) // string, number, boolean, select, date
  isRequired  Boolean   @default(false) @map("is_required")
  optionsJson Json?     @map("options_json")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, entityType, fieldKey])
  @@index([tenantId, entityType])
  @@map("custom_field_definition")
}

// -----------------------------------------------------------------------------
// Section 7 — Inventory Core Models
// -----------------------------------------------------------------------------

/// Warehouse storage location (Document 02 §23)
model Warehouse {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  companyId   String    @map("company_id")
  factoryId   String?   @map("factory_id")
  code        String    @db.VarChar(64)
  name        String
  type        String    @default("RM") @db.VarChar(32) // RM, WIP, FG, SPARE, SCRAP
  status      String    @default("active")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  company       Company            @relation(fields: [companyId], references: [id])
  factory       Factory?           @relation(fields: [factoryId], references: [id])
  stockBalances StockBalance[]
  stockLedgers  StockLedgerEntry[]

  fromTransfers StockTransfer[] @relation("FromWarehouse")
  toTransfers   StockTransfer[] @relation("ToWarehouse")
  adjustments   StockAdjustment[]
  grns          Grn[]
  dispatches    Dispatch[]
  steelScrapReceipts SteelScrapReceipt[]

  @@unique([tenantId, companyId, code])
  @@index([tenantId, companyId])
  @@map("warehouse")
}

/// Unit of Measure catalog (Document 02 §23.1)
model UnitOfMeasure {
  id        String    @id @default(uuid())
  tenantId  String    @map("tenant_id")
  code      String    @db.VarChar(32)
  name      String
  symbol    String?   @db.VarChar(16)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])

  items         Item[]
  stockLedgers  StockLedgerEntry[]
  transferLines StockTransferLine[]
  adjLines      StockAdjustmentLine[]
  bomLines      BomLine[]
  materialIssueLines WorkOrderMaterialIssueLine[]
  outputs       WorkOrderOutput[]
  scraps        WorkOrderScrap[]
  poLines       PurchaseOrderLine[]
  grnLines      GrnLine[]
  soLines       SalesOrderLine[]
  dispatchLines DispatchLine[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@map("uom")
}

/// Item Master Catalog (Document 02 §23.2)
model Item {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  companyId       String?   @map("company_id")
  code            String    @db.VarChar(64)
  name            String
  itemType        String    @default("RM") @map("item_type") @db.VarChar(32) // RM, WIP, FG, SPARE, CONSUMABLE
  uomId           String    @map("uom_id")
  trackingType    String    @default("none") @map("tracking_type") @db.VarChar(32) // none, lot, serial
  valuationMethod String    @default("average") @map("valuation_method") @db.VarChar(32) // standard, average, fifo
  status          String    @default("active")
  attrsJson       Json?     @map("attrs_json")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  company  Company?       @relation(fields: [companyId], references: [id])
  uom      UnitOfMeasure  @relation(fields: [uomId], references: [id])

  lots          Lot[]
  stockBalances StockBalance[]
  stockLedgers  StockLedgerEntry[]
  transferLines StockTransferLine[]
  adjLines      StockAdjustmentLine[]
  bomParentHeaders BomHeader[] @relation("ParentItem")
  bomComponentLines BomLine[] @relation("ComponentItem")
  workOrderOutputs WorkOrder[] @relation("OutputItem")
  materialIssueLines WorkOrderMaterialIssueLine[]
  poLines       PurchaseOrderLine[]
  grnLines      GrnLine[]
  soLines       SalesOrderLine[]
  dispatchLines DispatchLine[]

  @@unique([tenantId, code])
  @@index([tenantId, itemType, status])
  @@map("item")
}

/// Lot / Batch Tracking (Document 02 §23.4)
model Lot {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  itemId           String    @map("item_id")
  lotCode          String    @map("lot_code") @db.VarChar(64)
  manufacturedDate DateTime? @map("manufactured_date")
  expiryDate       DateTime? @map("expiry_date")
  attrsJson        Json?     @map("attrs_json")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  item   Item   @relation(fields: [itemId], references: [id])

  stockBalances StockBalance[]
  stockLedgers  StockLedgerEntry[]

  @@unique([tenantId, itemId, lotCode])
  @@index([tenantId, itemId])
  @@map("lot")
}

/// Materialized Stock Balance (Document 02 §23.3)
model StockBalance {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  warehouseId String   @map("warehouse_id")
  itemId      String   @map("item_id")
  lotId       String?  @map("lot_id")
  qtyOnHand   Float    @default(0) @map("qty_on_hand")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  item      Item      @relation(fields: [itemId], references: [id])
  lot       Lot?      @relation(fields: [lotId], references: [id])

  @@unique([warehouseId, itemId])
  @@index([tenantId, warehouseId])
  @@map("stock_balance")
}

/// Append-Only Stock Ledger Entry (Document 02 §23.5)
model StockLedgerEntry {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  companyId    String   @map("company_id")
  factoryId    String?  @map("factory_id")
  warehouseId  String   @map("warehouse_id")
  itemId       String   @map("item_id")
  lotId        String?  @map("lot_id")
  qtyIn        Float    @default(0) @map("qty_in")
  qtyOut       Float    @default(0) @map("qty_out")
  uomId        String   @map("uom_id")
  unitCost     Float?   @map("unit_cost")
  movementType String   @map("movement_type") @db.VarChar(32) // GRN, ISSUE, OUTPUT, TRANSFER_IN, TRANSFER_OUT, ADJUST
  refDocType   String?  @map("ref_doc_type") @db.VarChar(32)
  refDocId     String?  @map("ref_doc_id")
  refLineId    String?  @map("ref_line_id")
  occurredAt   DateTime @default(now()) @map("occurred_at")
  createdAt    DateTime @default(now()) @map("created_at")
  createdBy    String?  @map("created_by")

  tenant    Tenant        @relation(fields: [tenantId], references: [id])
  warehouse Warehouse     @relation(fields: [warehouseId], references: [id])
  item      Item          @relation(fields: [itemId], references: [id])
  lot       Lot?          @relation(fields: [lotId], references: [id])
  uom       UnitOfMeasure @relation(fields: [uomId], references: [id])

  @@index([tenantId, warehouseId, itemId, createdAt])
  @@map("stock_ledger_entry")
}

/// Stock Transfer Header (Document 02 §23.6)
model StockTransfer {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  transferNumber  String    @map("transfer_number") @db.VarChar(64)
  fromWarehouseId String    @map("from_warehouse_id")
  toWarehouseId   String    @map("to_warehouse_id")
  status          String    @default("draft") @db.VarChar(32) // draft, posted, cancelled
  notes           String?
  postedAt        DateTime? @map("posted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  tenant        Tenant              @relation(fields: [tenantId], references: [id])
  fromWarehouse Warehouse           @relation("FromWarehouse", fields: [fromWarehouseId], references: [id])
  toWarehouse   Warehouse           @relation("ToWarehouse", fields: [toWarehouseId], references: [id])
  lines         StockTransferLine[]

  @@unique([tenantId, transferNumber])
  @@index([tenantId])
  @@map("stock_transfer")
}

/// Stock Transfer Line Items
model StockTransferLine {
  id         String @id @default(uuid())
  transferId String @map("transfer_id")
  itemId     String @map("item_id")
  uomId      String @map("uom_id")
  qty        Float

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  item     Item          @relation(fields: [itemId], references: [id])
  uom      UnitOfMeasure @relation(fields: [uomId], references: [id])

  @@map("stock_transfer_line")
}

/// Stock Adjustment Header (Document 02 §23.7)
model StockAdjustment {
  id               String    @id @default(uuid())
  tenantId         String    @map("tenant_id")
  adjustmentNumber String    @map("adjustment_number") @db.VarChar(64)
  warehouseId      String    @map("warehouse_id")
  reasonCode       String    @map("reason_code") @db.VarChar(64) // e.g. AUDIT_DISCREPANCY, DAMAGE, EXPIRATION
  status           String    @default("draft") @db.VarChar(32) // draft, posted
  notes            String?
  postedAt         DateTime? @map("posted_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  tenant    Tenant                @relation(fields: [tenantId], references: [id])
  warehouse Warehouse             @relation(fields: [warehouseId], references: [id])
  lines     StockAdjustmentLine[]

  @@unique([tenantId, adjustmentNumber])
  @@index([tenantId])
  @@map("stock_adjustment")
}

/// Stock Adjustment Line Items
model StockAdjustmentLine {
  id           String @id @default(uuid())
  adjustmentId String @map("adjustment_id")
  itemId       String @map("item_id")
  uomId        String @map("uom_id")
  qty          Float  // positive = add stock, negative = remove stock

  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  item       Item            @relation(fields: [itemId], references: [id])
  uom        UnitOfMeasure   @relation(fields: [uomId], references: [id])

  @@map("stock_adjustment_line")
}

// -----------------------------------------------------------------------------
// Section 8 — Manufacturing Core Models
// -----------------------------------------------------------------------------

/// Bill of Materials Header (Document 02 §24.1)
model BomHeader {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  companyId     String?   @map("company_id")
  parentItemId  String    @map("parent_item_id")
  version       String    @default("v1.0") @db.VarChar(32)
  isActive      Boolean   @default(true) @map("is_active")
  effectiveFrom DateTime? @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  attrsJson     Json?     @map("attrs_json")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  parentItem Item      @relation("ParentItem", fields: [parentItemId], references: [id])
  lines      BomLine[]
  workOrders WorkOrder[]

  @@unique([tenantId, parentItemId, version])
  @@index([tenantId, parentItemId])
  @@map("bom_header")
}

/// Bill of Materials Line Items
model BomLine {
  id              String @id @default(uuid())
  bomHeaderId     String @map("bom_header_id")
  componentItemId String @map("component_item_id")
  qty             Float  @default(1.0)
  uomId           String @map("uom_id")
  scrapPercent    Float  @default(0.0) @map("scrap_percent")
  sequence        Int    @default(1)

  bomHeader     BomHeader     @relation(fields: [bomHeaderId], references: [id], onDelete: Cascade)
  componentItem Item          @relation("ComponentItem", fields: [componentItemId], references: [id])
  uom           UnitOfMeasure @relation(fields: [uomId], references: [id])

  @@map("bom_line")
}

/// Work Order Header (Document 02 §24.3)
model WorkOrder {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  companyId    String    @map("company_id")
  factoryId    String    @map("factory_id")
  docNo        String    @map("doc_no") @db.VarChar(64)
  docDate      DateTime  @default(now()) @map("doc_date")
  woType       String    @default("GENERIC") @map("wo_type") @db.VarChar(32) // MELT, ROLL, GENERIC
  status       String    @default("draft") @db.VarChar(32) // draft, released, in_progress, completed, cancelled
  itemId       String    @map("item_id") // Output FG item
  qtyPlanned   Float     @map("qty_planned")
  qtyCompleted Float     @default(0) @map("qty_completed")
  bomHeaderId  String?   @map("bom_header_id")
  priority     Int       @default(1)
  plannedStart DateTime? @map("planned_start")
  plannedEnd   DateTime? @map("planned_end")
  attrsJson    Json?     @map("attrs_json")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  tenant Tenant    @relation(fields: [tenantId], references: [id])
  item   Item      @relation("OutputItem", fields: [itemId], references: [id])
  bom    BomHeader? @relation(fields: [bomHeaderId], references: [id])

  materialIssues WorkOrderMaterialIssue[]
  outputs        WorkOrderOutput[]
  scraps         WorkOrderScrap[]
  energyLogs     EnergyLog[]

  @@unique([tenantId, companyId, docNo])
  @@index([tenantId, factoryId, status])
  @@map("work_order")
}

/// Work Order Material Issue Header (Document 02 §24.5)
model WorkOrderMaterialIssue {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  workOrderId String   @map("work_order_id")
  warehouseId String   @map("warehouse_id")
  issuedAt    DateTime @default(now()) @map("issued_at")
  notes       String?
  createdAt   DateTime @default(now()) @map("created_at")

  workOrder WorkOrder                    @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  lines     WorkOrderMaterialIssueLine[]

  @@index([tenantId, workOrderId])
  @@map("work_order_material_issue")
}

/// Work Order Material Issue Line
model WorkOrderMaterialIssueLine {
  id        String @id @default(uuid())
  issueId   String @map("issue_id")
  itemId    String @map("item_id")
  uomId     String @map("uom_id")
  qtyIssued Float  @map("qty_issued")

  issue WorkOrderMaterialIssue @relation(fields: [issueId], references: [id], onDelete: Cascade)
  item  Item                   @relation(fields: [itemId], references: [id])
  uom   UnitOfMeasure          @relation(fields: [uomId], references: [id])

  @@map("work_order_material_issue_line")
}

/// Work Order Production Output Receipt (Document 02 §24.6)
model WorkOrderOutput {
  id           String   @id @default(uuid())
  tenantId     String   @map("tenant_id")
  workOrderId  String   @map("work_order_id")
  warehouseId  String   @map("warehouse_id")
  qtyProduced  Float    @map("qty_produced")
  uomId        String   @map("uom_id")
  producedAt   DateTime @default(now()) @map("produced_at")
  lotCode      String?  @map("lot_code")
  attrsJson    Json?    @map("attrs_json")
  createdAt    DateTime @default(now()) @map("created_at")

  workOrder WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  uom       UnitOfMeasure @relation(fields: [uomId], references: [id])

  @@index([tenantId, workOrderId])
  @@map("work_order_output")
}

/// Work Order Scrap Log (Document 02 §24.7)
model WorkOrderScrap {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  workOrderId String   @map("work_order_id")
  qtyScrapped Float    @map("qty_scrapped")
  uomId       String   @map("uom_id")
  reasonCode  String   @map("reason_code") @db.VarChar(64)
  notes       String?
  scrappedAt  DateTime @default(now()) @map("scrapped_at")

  workOrder WorkOrder     @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  uom       UnitOfMeasure @relation(fields: [uomId], references: [id])

  @@map("work_order_scrap")
}

/// Utility & Energy Consumption Log (Document 02 §24.8)
model EnergyLog {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  factoryId   String   @map("factory_id")
  workOrderId String?  @map("work_order_id")
  utilityType String   @map("utility_type") @db.VarChar(32) // electricity, gas, water
  quantity    Float
  uomCode     String   @default("kWh") @map("uom_code") @db.VarChar(16)
  loggedAt    DateTime @default(now()) @map("logged_at")

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  workOrder WorkOrder? @relation(fields: [workOrderId], references: [id])

  @@index([tenantId, factoryId, loggedAt])
  @@map("energy_log")
}

// ==========================================
// SECTION 9: COMMERCIAL OPS (Document 02 §25)
// ==========================================

/// Unified Customer & Supplier Entity (Document 02 §25.1)
model Party {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  companyId    String?   @map("company_id")
  code         String    @db.VarChar(64)
  name         String
  isCustomer   Boolean   @default(false) @map("is_customer")
  isSupplier   Boolean   @default(false) @map("is_supplier")
  creditLimit  Float?    @map("credit_limit")
  paymentTerms String?   @map("payment_terms")
  contactsJson Json?     @map("contacts_json")
  attrs        Json?
  status       String    @default("active") @db.VarChar(32)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  tenant Tenant   @relation(fields: [tenantId], references: [id])
  company Company? @relation(fields: [companyId], references: [id])

  purchaseOrders PurchaseOrder[]
  grns           Grn[]
  salesOrders    SalesOrder[]
  dispatches     Dispatch[]
  steelScrapReceipts SteelScrapReceipt[]

  @@unique([tenantId, code])
  @@index([tenantId, status])
  @@map("party")
}

/// Purchase Order Header (Document 02 §25.2)
model PurchaseOrder {
  id           String    @id @default(uuid())
  tenantId     String    @map("tenant_id")
  companyId    String    @map("company_id")
  partyId      String    @map("party_id") // Supplier
  docNo        String    @map("doc_no") @db.VarChar(64)
  docDate      DateTime  @default(now()) @map("doc_date")
  status       String    @default("draft") @db.VarChar(32) // draft, approved, completed, cancelled
  currency     String    @default("USD") @db.VarChar(8)
  totalAmount  Float     @default(0.0) @map("total_amount")
  attrs        Json?
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  tenant  Tenant              @relation(fields: [tenantId], references: [id])
  company Company             @relation(fields: [companyId], references: [id])
  party   Party               @relation(fields: [partyId], references: [id])
  lines   PurchaseOrderLine[]
  grns    Grn[]

  @@unique([tenantId, companyId, docNo])
  @@map("purchase_order")
}

/// Purchase Order Line
model PurchaseOrderLine {
  id              String @id @default(uuid())
  purchaseOrderId String @map("purchase_order_id")
  itemId          String @map("item_id")
  uomId           String @map("uom_id")
  qty             Float
  unitPrice       Float  @default(0.0) @map("unit_price")
  amount          Float  @default(0.0)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  item          Item          @relation(fields: [itemId], references: [id])
  uom           UnitOfMeasure @relation(fields: [uomId], references: [id])

  @@map("purchase_order_line")
}

/// Goods Receipt Note (GRN) (Document 02 §25.3)
model Grn {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  companyId       String    @map("company_id")
  factoryId       String?   @map("factory_id")
  warehouseId     String    @map("warehouse_id")
  partyId         String    @map("party_id") // Supplier
  purchaseOrderId String?   @map("purchase_order_id")
  docNo           String    @map("doc_no") @db.VarChar(64)
  docDate         DateTime  @default(now()) @map("doc_date")
  status          String    @default("draft") @db.VarChar(32) // draft, confirmed, cancelled
  vehicleNo       String?   @map("vehicle_no")
  attrs           Json?
  receivedAt      DateTime? @map("received_at")
  createdAt       DateTime  @default(now()) @map("created_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  company       Company        @relation(fields: [companyId], references: [id])
  warehouse     Warehouse      @relation(fields: [warehouseId], references: [id])
  party         Party          @relation(fields: [partyId], references: [id])
  purchaseOrder PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])
  lines         GrnLine[]

  @@unique([tenantId, companyId, docNo])
  @@map("grn")
}

/// GRN Line
model GrnLine {
  id          String @id @default(uuid())
  grnId       String @map("grn_id")
  itemId      String @map("item_id")
  uomId       String @map("uom_id")
  qtyReceived Float  @map("qty_received")
  unitCost    Float  @default(0.0) @map("unit_cost")

  grn  Grn           @relation(fields: [grnId], references: [id], onDelete: Cascade)
  item Item          @relation(fields: [itemId], references: [id])
  uom  UnitOfMeasure @relation(fields: [uomId], references: [id])

  @@map("grn_line")
}

/// Sales Order Header (Document 02 §25.4)
model SalesOrder {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  companyId   String    @map("company_id")
  partyId     String    @map("party_id") // Customer
  docNo       String    @map("doc_no") @db.VarChar(64)
  docDate     DateTime  @default(now()) @map("doc_date")
  status      String    @default("draft") @db.VarChar(32) // draft, confirmed, completed, cancelled
  currency    String    @default("USD") @db.VarChar(8)
  totalAmount Float     @default(0.0) @map("total_amount")
  attrs       Json?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  company    Company          @relation(fields: [companyId], references: [id])
  party      Party            @relation(fields: [partyId], references: [id])
  lines      SalesOrderLine[]
  dispatches Dispatch[]

  @@unique([tenantId, companyId, docNo])
  @@map("sales_order")
}

/// Sales Order Line
model SalesOrderLine {
  id           String @id @default(uuid())
  salesOrderId String @map("sales_order_id")
  itemId       String @map("item_id")
  uomId        String @map("uom_id")
  qty          Float
  unitPrice    Float  @default(0.0) @map("unit_price")
  amount       Float  @default(0.0)

  salesOrder SalesOrder    @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  item       Item          @relation(fields: [itemId], references: [id])
  uom        UnitOfMeasure @relation(fields: [uomId], references: [id])

  @@map("sales_order_line")
}

/// Dispatch / Challan Header (Document 02 §25.5)
model Dispatch {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  companyId     String    @map("company_id")
  factoryId     String?   @map("factory_id")
  warehouseId   String    @map("warehouse_id")
  partyId       String    @map("party_id") // Customer
  salesOrderId  String?   @map("sales_order_id")
  docNo         String    @map("doc_no") @db.VarChar(64)
  docDate       DateTime  @default(now()) @map("doc_date")
  status        String    @default("draft") @db.VarChar(32) // draft, confirmed, cancelled
  vehicleNo     String?   @map("vehicle_no")
  freightAmount Float     @default(0.0) @map("freight_amount")
  currency      String    @default("USD") @db.VarChar(8)
  attrs         Json?
  confirmedAt   DateTime? @map("confirmed_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  company    Company       @relation(fields: [companyId], references: [id])
  warehouse  Warehouse     @relation(fields: [warehouseId], references: [id])
  party      Party         @relation(fields: [partyId], references: [id])
  salesOrder SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  lines      DispatchLine[]

  @@unique([tenantId, companyId, docNo])
  @@map("dispatch")
}

/// Dispatch Line
model DispatchLine {
  id         String @id @default(uuid())
  dispatchId String @map("dispatch_id")
  itemId     String @map("item_id")
  uomId      String @map("uom_id")
  qty        Float
  unitPrice  Float  @default(0.0) @map("unit_price")
  amount     Float  @default(0.0)

  dispatch Dispatch      @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  item     Item          @relation(fields: [itemId], references: [id])
  uom      UnitOfMeasure @relation(fields: [uomId], references: [id])

  @@map("dispatch_line")
}

// ==========================================
// SECTION 10: STEEL MANUFACTURING VERTICAL (Document 01 §16.5 & Doc 02 §33)
// ==========================================

/// FRM-STL-01 Scrap Receiving Log
model SteelScrapReceipt {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  companyId     String   @map("company_id")
  warehouseId   String   @map("warehouse_id")
  partyId       String   @map("party_id") // Supplier
  gradeCategory String   @map("grade_category") @db.VarChar(64) // Heavy Melting Scrap, Shredded, Turning
  vehicleNo     String?  @map("vehicle_no")
  receivedKg    Float    @map("received_kg")
  expenses      Float    @default(0.0)
  remarks       String?
  attrs         Json?
  receivedAt    DateTime @default(now()) @map("received_at")

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  company   Company   @relation(fields: [companyId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])
  party     Party     @relation(fields: [partyId], references: [id])

  @@index([tenantId, warehouseId])
  @@map("steel_scrap_receipt")
}

/// FRM-STL-02 Steel Heat Log (Furnace / Induction Melting)
model SteelHeatLog {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  companyId     String   @map("company_id")
  factoryId     String   @map("factory_id")
  heatNo        String   @map("heat_no") @db.VarChar(64)
  furnaceNo     String   @default("Furnace-1") @map("furnace_no") @db.VarChar(32)
  scrapInputKg  Float    @map("scrap_input_kg")
  billetOutputKg Float   @map("billet_output_kg")
  billetSize    String   @default("150x150") @map("billet_size") @db.VarChar(32)
  powerKwh      Float    @default(0.0) @map("power_kwh")
  gasNm3        Float    @default(0.0) @map("gas_nm3")
  runtimeMin    Int      @default(0) @map("runtime_min")
  downtimeMin   Int      @default(0) @map("downtime_min")
  shift         String   @default("Shift-A") @db.VarChar(16)
  remarks       String?
  loggedAt      DateTime @default(now()) @map("logged_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
  factory Factory @relation(fields: [factoryId], references: [id])

  @@unique([tenantId, factoryId, heatNo])
  @@map("steel_heat_log")
}

/// FRM-STL-04 Steel Rolling Mill Log (Billet to Rod / Rebar)
model SteelRollingLog {
  id            String   @id @default(uuid())
  tenantId      String   @map("tenant_id")
  companyId     String   @map("company_id")
  factoryId     String   @map("factory_id")
  heatRef       String?  @map("heat_ref") @db.VarChar(64)
  billetInputKg Float    @map("billet_input_kg")
  rodOutputKg   Float    @map("rod_output_kg")
  rodSizeSpec   String   @default("12mm Grade 60") @map("rod_size_spec") @db.VarChar(64)
  burningLossKg Float    @default(0.0) @map("burning_loss_kg")
  downtimeMin   Int      @default(0) @map("downtime_min")
  shift         String   @default("Shift-A") @db.VarChar(16)
  remarks       String?
  loggedAt      DateTime @default(now()) @map("logged_at")

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  company Company @relation(fields: [companyId], references: [id])
  factory Factory @relation(fields: [factoryId], references: [id])

  @@map("steel_rolling_log")
}

/// Section 13 — Immutable Append-Only Audit Log
model AuditLog {
  id          String   @id @default(uuid())
  tenantId    String?  @map("tenant_id")
  userId      String?  @map("user_id")
  action      String   @db.VarChar(128)
  entityType  String   @map("entity_type") @db.VarChar(64)
  entityId    String?  @map("entity_id") @db.VarChar(64)
  ipAddress   String?  @map("ip_address") @db.VarChar(64)
  userAgent   String?  @map("user_agent")
  payloadJson Json?    @map("payload_json")
  createdAt   DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([tenantId, createdAt])
  @@index([userId, action])
  @@map("audit_log")
}





