# Softlligence Manufacturing Cloud — Web
# Copy to .env.local. Never commit secrets.

# Browser-visible API base (empty = use Next rewrites to API_URL)
NEXT_PUBLIC_APP_NAME="Softlligence Manufacturing Cloud"
NEXT_PUBLIC_APP_VERSION="0.1.0"

# Server-side rewrite target (Next.js → Render/local API)
API_URL="http://localhost:5001"
